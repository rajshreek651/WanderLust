<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3 mb-4">SignUp on WanderLust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" novalidate class="needs-validation">

            <div class="mb-4">
                <label for="email" id="email" class="form-label">Email</label>
                <input name="email" type="email" class="form-control" required>
            </div>

            <div class="mb-4">
                <label for="username" id="username" class="form-label">Username</label>
                <input name="username" type="text" class="form-control" required>
                <div class="valid-feedback">Looks good!</div> <!-- This can show success and failure message while filling the form. Which can be helpful if user mistook the valid data in the input fields -->
            </div>

            <div class="mb-4">
                <label for="password" id="password" class="form-label">Password</label>
                <input name="password" type="password" class="form-control" required>
                <div class="invalid-feedback">Create a strong password.</div> <!-- This can show success and failure message while filling the form. Which can be helpful if user mistook the valid data in the input fields -->
            </div>

            <button class="btn btn-success">SignUp</button>
        </form>

    </div>
</div>