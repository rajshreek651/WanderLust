<style>

    .navbar{
        margin: 0;
        padding: 0;
        height: 120px;
        width: 100%;
        background-color: aliceblue;
        display: flex;
        flex-direction: column;
    }

    .nav-logo-and-opts{
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #fff;
        padding: 1rem;
    }

    .fa-compass{
        color: #fe424d;
        position: absolute;
        right: 20px;
        top: 10px;
    }

    .opts a{
        text-decoration: none;
        color: rgba(0, 0, 0, 0.7);
    }

    /* Search bar */
    .search-sec{
        margin-bottom: 0.5rem;
    }

    .search-btn{
        background-color: #fe424d;
        color: #fff;
        border-radius: 50%;
    }
    .search-btn:hover{
        background-color: #fe424d;
        color: #fff;
    }

    .search-inp{
        border-radius: 25px;
        padding: 0.5rem 3rem 0.5rem 3rem;
    }

    

    

    /* Desktop View */
    @media (min-width: 768px) {

        /* Hide hamburger */
        .btn_one,
        .sidebar_menu,
        #check {
            display: none;
        }

        /* Show normal navbar links */
        .desktop-menu {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 80%;
        }
    }


    @media (max-width: 768px) {

        /* Show hamburger */
        /* MAKING RESPONSIVE NAVBAR */

    /* Style for Hamburger menu in mobile view */
    .main_box{
        height: 100vh;
        background-color: #fff;
        z-index: 3;
    }

    .btn_one i{
        color: rgba(0,0,0,0.7);
        font-size: 30px;
        font-weight: 700;
        position: absolute;
        left: 16px;
        line-height: 60px;
        transition: all 0.3s linear;
    }

    .sidebar_menu{
        position: fixed;
        /* left: 0; */
        top: 0;
        left: -300px;
        height: 100vh;
        width: 300px;
        background-color: white;
        box-shadow: 0 0 6px rgba(0,0,0,0.5);
        transition: all 0.3s linear;
    }

    .sidebar_menu .logo{
        position: absolute;
        width: 100%;
        height: 60px;
        line-height: 60px;
        box-shadow: 0 0 4px rgba(0,0,0,0.7);
    }

    .sidebar_menu .logo a{
        position: absolute;
        left: 60px;
        color: rgba(0,0,0,0.7);
        text-decoration: none;
        font-size: 20px;
        font-weight: 600;
    }

    .btn_two i{
        color: grey;
        opacity: 0.5;
        font-size: 25px;
        position: absolute;
        right: 16px;
        line-height: 60px;
        cursor: pointer;
        transition: all 0.3s linear;
    }

    .sidebar_menu .menu{
        position: absolute;
        top: 80px;
        width: 100%;
        color: rgba(0,0,0,0.7);
    }

    .sidebar_menu .menu ul{
        list-style: none;
        color: rgba(0,0,0,0.7);
    }

    .sidebar_menu .menu ul li{
        margin-top: 6px;
        padding: 14px 20px;
    }

    .sidebar_menu .menu i,a{
        color: rgba(0,0,0,0.7);
        text-decoration: none;
        font-size: 18px;
    }

    .sidebar_menu .menu i{
        margin-right: 10px;
    }

    .sidebar_menu .social_media{
        position: absolute;
        left: 15%;
        bottom: 30px;
    }

    .sidebar_menu .social_media i{
        color: rgba(0,0,0,0.7);
        opacity: 0.5;
        font-size: 20px;
        margin: 0 8px;
    }

    #check{
        display: none;
    }

    .sidebar_menu .menu li:hover{
        box-shadow: 0 0 6px rgba(0,0,0,0.5);
    }

    .btn_one i:hover{
        font-size: 40px;
    }
    .btn_two i:hover{
        font-size: 30px;
    }

    .sidebar_menu .social_media i:hover{
        opacity: 1;
        transform: scale(1.3);
    }

    #check:checked ~ .sidebar_menu{
        left: 0;
    }

    #check:checked ~ .btn_one{
        opacity: 0;
    }

        /* HIDE normal navbar links */
        .desktop-menu {
            display: none;
        }
    }
</style>

<div class="navbar">

    <div class="nav-logo-and-opts">

        <!--for desktop view-->
        <div class="desktop-menu">
            <div class="opts"><a href="/listings">Explore</a></div>
            <div class="opts"><a href="/listings/new">Airbnb your home</a></div>
            <div class="opts"><a href="#">Shortcuts</a></div>
            <div class="opts"><a href="#">Contact</a></div>

            <% if(!currUser){ %>
                <div class="opts"><a class="nav-link" href="/signup"><b>SignUp</b></a></div>
                <div class="opts"><a class="nav-link" href="/login"><b>Login</b></a></div>
            <% } %>

            <% if(currUser){ %>
                <div class="opts"><a class="nav-link" href="/logout"><b>Logout</b></a></div>
            <% } %>
        </div>


        <!-- for mobile view -->
        <div class="main_box">

            <input type="checkbox" id="check" />
            <div class="btn_one">
                <label for="check">
                    <i class="fa-solid fa-bars"></i>
                </label>
            </div>

            <div class="sidebar_menu">

                <div class="logo">
                    <a href="/listings">Explore</a>
                </div>

                <div class="btn_two">
                    <label for="check">
                        <i class="fa-solid fa-xmark"></i>
                    </label>
                </div>


                <div class="menu">
                    <ul>
                        <li> 
                            <i class="fa-solid fa-photo-film"></i>
                            <a href="/listings/new">Airbnb your home</a>
                        </li>

                        <li>
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                            <a href="#">Shortcuts</a>
                        </li>

                        <li>
                            <i class="fa-solid fa-phone"></i>
                            <a href="#">Contact</a>
                        </li>

                        <hr>

                        <% if(!currUser){ %>
                            <li><a class="nav-link" href="/signup"><b>SignUp</b></a></li>
                            <li><a class="nav-link" href="/login"><b>Login</b></a></li>
                        <% } %>

                        <% if(currUser){ %>
                            <li><a class="nav-link" href="/logout"><b>Logout</b></a></li>
                        <% } %>        
                    </ul>
                </div>

                <div class="social_media">
                    <ul>
                        <a href="#"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </ul>
                </div>
            </div>

        </div>

        <!-- Logo with home link -->
        <div><a href="/listings"><i class="fa-regular fa-compass"></i></a></div>
    </div>

    <!-- Search bar -->
    <div class="search-sec">
        <form class="d-flex" role="search">
            <input class="form-control me-2 search-inp" type="search" placeholder="Search destinaton"/>
            <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </div>

</div>